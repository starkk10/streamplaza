# ── Base de datos ─────────────────────────────────────────────
# Local (npm run db:local): postgresql://streamplaza:streamplaza@localhost:54330/streamplaza
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/streamplaza"

# ── Aplicación ────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Cifra los códigos y licencias. Si lo pierdes, los códigos guardados no se pueden leer.
ENCRYPTION_KEY=""
# Protege la ruta /api/cron para un cron externo (opcional si usas npm run worker)
CRON_SECRET=""
# Carpeta privada para los comprobantes de pago (fuera de /public)
UPLOAD_DIR="./storage/uploads"

# Primer administrador (lo crea: npm run admin:create)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Correo (SMTP) ─────────────────────────────────────────────
# Sin estos datos, las notificaciones por correo quedan como "omitidas".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="StreamPlaza <no-reply@tudominio.com>"

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────
# Panel de Meta for Developers → tu app → WhatsApp → Configuración de la API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# App → Configuración → Básica → Clave secreta de la app (verifica la firma de los webhooks)
WHATSAPP_APP_SECRET=""
# Texto que inventas tú y pegas también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Plantilla aprobada para mensajes fuera de la ventana de 24 h (recordatorios).
# Debe tener un cuerpo con 1 variable: {{1}} = texto del aviso. Vacío = no se envían por WhatsApp.
WHATSAPP_TEMPLATE_NOTICE=""
WHATSAPP_TEMPLATE_LANG="es"
