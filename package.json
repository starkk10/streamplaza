{
  "name": "streamplaza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "jobs:once": "tsx --env-file=.env scripts/worker.ts --once",
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "15.5.4",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.16.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/client@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "prisma@6.16.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
